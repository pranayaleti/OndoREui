# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_your_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only (NOT prefixed with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# HubSpot (optional)
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=your-portal-id
HUBSPOT_ACCESS_TOKEN=pat-your-hubspot-token

# Backend API base URL — required for lead form submissions, calculators, AI chat
# Local: http://localhost:3030  ·  Prod (Supabase Edge): https://<project>.supabase.co/functions/v1/api
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:3030

# Google Analytics (optional). Leave blank until you have a real measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Marketing / retargeting pixels (all optional — each is a no-op without a real ID)
# Preferred setup: configure GTM once below, then add the other 3 pixels INSIDE GTM.
# Do not paste fake IDs like GTM-XXXXXXX or 0000000; those fire failing network requests.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# rb2b — anonymous visitor identification (optional, paid)
NEXT_PUBLIC_REB2B_KEY=

# Public site phone (header, footer, tel: links). Keep in sync with dashboard companyInfo
# until a documented Utah production number exists. Do not invent an 801/385 default.
NEXT_PUBLIC_SITE_PHONE=+1-408-538-0420

# WhatsApp Business floating chat button (optional, no-op if unset)
# E.164 digits only — no +, spaces, or hyphens. Example: 14085380420 = +1 (408) 538-0420
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Anthropic AI (optional)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# App Environment
NEXT_PUBLIC_APP_ENV=development

# Public demo hub (optional)
NEXT_PUBLIC_DEMO_DASHBOARD_URL=https://demo.ondorealestate.com
NEXT_PUBLIC_DEMO_VIDEO_EMBED_URL=https://www.youtube.com/embed/your-demo-video-id
