# INERT ON GITHUB PAGES. GitHub Pages ignores this file: the site is served from there behind
# Cloudflare, so none of the rules below (cache or security headers) reach a browser. It is kept as
# the source for hosts that do read _headers (Cloudflare Pages, Netlify).
# The headers that matter are set with Cloudflare Transform Rules: see docs/SECURITY_HEADERS.md.
# Cache behaviour on the live site comes from Cloudflare Cache Rules (scripts/cloudflare-cache-html-rule.json).

# Cache static assets for 1 year
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images in public/ and public/_optimized/ keep stable file names (logo-light.png, Linktree-640w.webp),
# so they are not content-hashed: a replaced image must reach returning visitors within a week, not a year.
# Only /_next/static/ above is hashed and safe to mark immutable.
/*.png
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.jpeg
  Cache-Control: public, max-age=604800
/*.webp
  Cache-Control: public, max-age=604800
/*.avif
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800

# Cache fonts for 1 year
/*.woff
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.ttf
  Cache-Control: public, max-age=31536000, immutable
/*.otf
  Cache-Control: public, max-age=31536000, immutable

# Cache CSS and JS for 1 year (with versioning)
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable

# HTML files - short cache with revalidation; keeps pages bfcache-eligible
/*.html
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=3600

# JSON and XML files
/*.json
  Cache-Control: public, max-age=86400
/*.xml
  Cache-Control: public, max-age=86400

# AI / crawler briefs (match route Cache-Control; longer edge cache is safe — content versioned by deploy)
# CORS: allow browser-based assistants / extensions to fetch public indexes (read-only marketing content)
/llms.txt
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Max-Age: 86400
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/llm.txt
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Max-Age: 86400
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/.well-known/llms.txt
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Max-Age: 86400
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/llms-full.txt
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Max-Age: 86400
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/llms.json
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Max-Age: 86400
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/robots.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/sitemap.xml
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/index.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Max-Age: 86400
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
# First-party Markdown twins for JS-heavy pages (generated by
# scripts/generate-agent-markdown.ts). GitHub Pages does not honor _headers
# but Cloudflare Pages / Netlify do; the explicit MIME type also makes the
# intent obvious for any host inspecting the origin.
/sitemap.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Max-Age: 86400
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/properties.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Max-Age: 86400
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/contact.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Max-Age: 86400
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/calculators/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Max-Age: 86400
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
# Generic fallback for any other .md file — covers future additions.
/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Max-Age: 86400
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/.well-known/agents.json
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Max-Age: 86400
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/.well-known/security.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Security and document cache (root); short cache keeps HTML bfcache-eligible
/*
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=3600
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), display-capture=()

