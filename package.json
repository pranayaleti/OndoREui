{
  "name": "ondo-real-estate",
  "version": "0.1.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "private": true,
  "overrides": {
    "browserslist": "^4.28.8"
  },
  "homepage": "https://www.ondorealestate.com",
  "scripts": {
    "clean": "rm -rf .next node_modules/.cache",
    "clean:all": "rm -rf .next node_modules/.cache out",
    "prebuild": "npm run generate:agent-md",
    "build": "next build",
    "build:full": "npm run optimize:images && npm run optimize:all-images && next build",
    "postbuild": "next-sitemap && npm run copy:headers && npm run generate:legacy-redirects && npm run generate:discovery && npm run generate:html-md && npm run check:llms-txt && npm run check:main-landmark",
    "generate:agent-md": "npx tsx scripts/generate-agent-markdown.ts",
    "dev": "next dev",
    "dev:prod-like": "next dev -p 3100",
    "dev:clean": "npm run clean && next dev",
    "lint": "next lint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "next start",
    "sitemap": "next-sitemap",
    "predeploy": "npm run build:full && cp CNAME out/ && touch out/.nojekyll",
    "deploy": "gh-pages -d out",
    "export": "next build",
    "optimize:images": "node scripts/optimize-images.mjs",
    "optimize:all-images": "node scripts/optimize-all-images.mjs",
    "copy:headers": "cp public/_headers out/_headers 2>/dev/null || true",
    "generate:legacy-redirects": "node scripts/generate-legacy-redirects.mjs",
    "generate:discovery": "npx tsx scripts/generate-discovery-files.ts",
    "check:llms-txt": "node scripts/check-llms-txt-export.mjs",
    "check:main-landmark": "node scripts/check-main-landmark.mjs",
    "check:links": "npx tsx scripts/check-links.ts",
    "check:seo": "node scripts/check-seo-export.mjs",
    "verify:agent-readability": "node scripts/verify-agent-readability.mjs",
    "cloudflare:markdown": "node scripts/enable-cloudflare-markdown.mjs",
    "cloudflare:agent-readability": "python3 scripts/apply-cloudflare-agent-readability.py",
    "generate:html-md": "npx tsx scripts/generate-html-markdown-twins.ts",
    "generate:blogs": "npx tsx scripts/generate-city-blogs.ts",
    "generate:blogs:dry": "npx tsx scripts/generate-city-blogs.ts --dry-run",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "check:unused": "node scripts/check-unused-deps.mjs",
    "a11y:axe": "playwright test tests/a11y.spec.ts",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:links": "playwright test tests/links-page.spec.ts",
    "test:popups": "playwright test tests/verify-popups.spec.ts",
    "a11y:serve": "next build && npx --yes serve@14 out -l 3000 --no-clipboard",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "indexnow:dry": "node scripts/submit-indexnow.mjs --dry-run",
    "indexnow:all": "node scripts/submit-indexnow.mjs --all"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.4.2",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-aspect-ratio": "1.1.15",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "1.1.24",
    "@radix-ui/react-navigation-menu": "1.2.22",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/react": "^10.51.0",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.9.0",
    "@supabase/supabase-js": "^2.117.2",
    "@types/leaflet": "^1.9.22",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "critters": "^0.0.25",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "8.6.0",
    "geist": "^1.7.2",
    "html2canvas": "^1.4.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.4",
    "input-otp": "1.5.0",
    "jspdf": "^4.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.454.0",
    "next": "^15.5.6",
    "next-themes": "^0.4.6",
    "react": "^18.2.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-is": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.12.7",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^25.0.1",
    "jsqr": "^1.4.0",
    "next-sitemap": "^4.2.3",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.55.1",
    "postcss": "^8.5",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "wait-on": "^9.4.0"
  }
}
